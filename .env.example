# Runtime
PORT=4173
APP_ORIGIN=http://localhost:4173
DATA_MODE=demo

# Qloo: required when DATA_MODE=live or QLOO_MODE=live
QLOO_MODE=demo
# Live judging uses the event-supported @qloo/qloo-harness surface.
QLOO_SURFACE=harness
# Either run `qloo setup --qloo` or inject the event credential server-side.
QLOO_API_KEY=
QLOO_COMMAND=qloo
QLOO_TIMEOUT_MS=30000
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Channel3 is discovery only. It is never used for checkout.
CATALOG_MODE=demo
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_COUNTRY=US
CHANNEL3_CURRENCY=USD

# PayPal Orders v2 is called server-side only.
PAYPAL_MODE=demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:4173/?paypal=return
PAYPAL_CANCEL_URL=http://localhost:4173/?paypal=cancel

# Change in any shared or hosted environment.
APPROVAL_SECRET=replace-with-a-long-random-value
